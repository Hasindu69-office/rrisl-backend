{
  "collectionName": "components_department_introduction_sections",
  "info": {
    "displayName": "introductionsection"
  },
  "options": {},
  "attributes": {
    "sectionheader": {
      "type": "component",
      "component": "shared.section-header",
      "repeatable": false,
      "required": true
    },
    "paragraph": {
      "type": "text",
      "minLength": 10,
      "required": true
    },
    "closingparagraph": {
      "type": "text"
    },
    "backgroundimage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "featureimage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "points": {
      "type": "component",
      "component": "shared.points",
      "repeatable": true,
      "required": false,
      "min": 1
    },
    "videotitle": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255
    },
    "includethumbnail": {
      "type": "boolean",
      "default": false
    },
    "videothumbnail": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "includethumbnail"
            },
            true
          ]
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "url": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "required": true
    }
  },
  "config": {}
}
